// Production Prisma Schema for Dime Financial Engine
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Tier {
  FREE
  PREMIUM
}

enum ConnectionStatus {
  ACTIVE
  REQUIRES_REAUTH
  DISCONNECTED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLING
  CANCELLED
  DISPUTED
}

enum Cadence {
  WEEKLY
  MONTHLY
  ANNUAL
}

enum KillMethod {
  DIRECT_MANDATE
  LEGAL_NOTICE
  HEADLESS_PORTAL
}

enum JobStatus {
  PENDING
  IN_PROGRESS
  REQUIRES_2FA
  COMPLETED
  FAILED
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  fullName            String
  tier                Tier               @default(FREE)
  performanceFeeOpted Boolean            @default(false)
  stripeCustomerId    String?
  bankConnections     BankConnection[]
  subscriptions       Subscription[]
  cancellationJobs    CancellationJob[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model BankConnection {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId    String
  institutionName  String
  status           ConnectionStatus @default(ACTIVE)
  plaidItemId      String
  accessTokenEnc   String
  lastSyncedAt     DateTime         @default(now())
  transactions     Transaction[]
  createdAt        DateTime         @default(now())
}

model Transaction {
  id               String          @id @default(uuid())
  bankConnectionId String
  bankConnection   BankConnection  @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)
  rawDescriptor    String
  amount           Decimal         @db.Decimal(10, 2)
  date             DateTime
  category         String
  createdAt        DateTime        @default(now())
}

model Subscription {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantName       String
  category           String
  billingAmount      Decimal            @db.Decimal(10, 2)
  currency           String             @default("USD")
  billingCycle       Cadence            @default(MONTHLY)
  confidenceScore    Decimal            @db.Decimal(3, 2)
  status             SubscriptionStatus @default(ACTIVE)
  daysInactive       Int                @default(0)
  cancellationMethod KillMethod         @default(HEADLESS_PORTAL)
  nextBillingDate    DateTime
  cancellationJobs   CancellationJob[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model CancellationJob {
  id                   String       @id @default(uuid())
  subscriptionId       String
  subscription         Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId               String
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  method               KillMethod
  status               JobStatus    @default(PENDING)
  savingsCalculated    Decimal      @db.Decimal(10, 2)
  performanceFeeCharged Decimal     @db.Decimal(10, 2)
  logs                 Json
  otpRequiredFor       String?
  cancellationProofUrl String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model MarketplaceOffer {
  id                      String   @id @default(uuid())
  category                String
  currentProvider         String
  suggestedProvider       String
  currentEstimatedMonthly Decimal  @db.Decimal(10, 2)
  suggestedMonthly        Decimal  @db.Decimal(10, 2)
  annualSavings           Decimal  @db.Decimal(10, 2)
  affiliateBounty         Decimal  @db.Decimal(10, 2)
  actionUrl               String
  highlight               String
  createdAt               DateTime @default(now())
}

