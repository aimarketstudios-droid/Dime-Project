# Dime API Environment Variables
PORT=4000
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
ALLOWED_ORIGINS=*

# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://postgres:password@localhost:5432/dime_production

# Redis Cache & Queue (Upstash / AWS ElastiCache)
REDIS_URL=redis://localhost:6379

# Plaid Financial Aggregator Keys
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox # sandbox | development | production

# Stripe (Performance Fee Collection)
STRIPE_SECRET_KEY=sk_live_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# RevenueCat (In-App Subscriptions)
REVENUECAT_SECRET_KEY=rc_live_your_key

